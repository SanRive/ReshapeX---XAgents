# Copiar a .env y llenar. El .env NUNCA se commitea (ver .gitignore).
# Verificar el ID exacto del modelo antes de escribirlo:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" \
#     | python3 -m json.tool | grep '"id"'

# --- Groq: proveedor principal ---
GROQ_API_KEY=
GROQ_MODEL=

# Segunda key de Groq, de otra cuenta. Cubre el rate limit del tier gratis,
# NO cubre una caida de Groq: para eso esta Gemini.
GROQ_API_KEY_2=

# --- Gemini: fallback de otro proveedor ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Opcional: observabilidad ---
LANGSMITH_API_KEY=

# --------------------------------------------------------------------------
# Nota para la app Next.js
# --------------------------------------------------------------------------
# Next lee .env.local, no .env. Copiar las mismas variables alli.
#
# Los provider packages del Vercel AI SDK leen nombres de variable FIJOS.
# Verificar los nombres exactos en la doc del provider antes de perder tiempo
# depurando un "missing API key" que en realidad es un nombre mal puesto:
#   @ai-sdk/groq    -> GROQ_API_KEY
#   @ai-sdk/google  -> GOOGLE_GENERATIVE_AI_API_KEY   (NO GEMINI_API_KEY)
#
# Ninguna de estas variables lleva prefijo NEXT_PUBLIC_. Si una API key llega
# al bundle del cliente, queda expuesta en el navegador.
GOOGLE_GENERATIVE_AI_API_KEY=
